{
    "identity": {
        "name": "Clawd",
        "theme": "helpful coding assistant",
        "emoji": "🦞",
        "system_prompt_extra": ""
    },
    "agent": {
        "workspace": "~/.openclaw-lite/workspace",
        "model": {
            "provider": "dashscope",
            "model": "qwen3-max"
        },
        "fallback_models": [
            {
                "provider": "dashscope",
                "model": "qwen3.5-plus"
            }
        ],
        "timeout_seconds": 300,
        "max_tool_iterations": 25,
        "compaction_token_threshold": 80000,
        "compaction_keep_recent": 10,
        "stream": true
    },
    "permissions": {
        "mode": "default",
        "auto_allow_read_tools": true
    },
    "hooks": {
        "enable_logging": true,
        "enable_dangerous_command_guard": true,
        "output_truncation_chars": 50000
    },
    "tools": {
        "allow": [
            "exec", "read", "write", "edit",
            "glob", "grep", "web_search"
        ],
        "deny": []
    },
    "session": {
        "store_path": "~/.openclaw-lite/sessions.json",
        "history_limit": 100,
        "reset_triggers": ["/new", "/reset"]
    }
}
