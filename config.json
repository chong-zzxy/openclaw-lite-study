{
    "identity": {
        "name": "Clawd",
        "theme": "helpful coding assistant",
        "emoji": "🦞",
        "system_prompt_extra": ""
    },
    "agent": {
        "workspace": "~/.openclaw-lite/workspace",
        "model": {
            "provider": "dashscope",
            "model": "qwen3-max"
        },
        "fallback_models": [
            {
                "provider": "dashscope",
                "model": "qwen-plus"
            }
        ],
        "timeout_seconds": 300,
        "max_tool_iterations": 20,
        "compaction_threshold": 40
    },
    "hooks": {
        "enable_logging": true,
        "enable_dangerous_command_guard": true,
        "output_truncation_chars": 50000
    },
    "tools": {
        "allow": [
            "exec",
            "read",
            "write",
            "edit",
            "web_search"
        ],
        "deny": []
    },
    "session": {
        "store_path": "~/.openclaw-lite/sessions.json",
        "history_limit": 50,
        "reset_triggers": [
            "/new",
            "/reset"
        ]
    }
}
